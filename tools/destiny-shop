function countUp(el,target,dur){const s=performance.now();(function step(t){const p=Math.min((t-s)/dur,1);el.textContent=Math.round(target*p);if(p<1)requestAnimationFrame(step);})(s);}

/* =========================================================
   상점 (Phase 2) — 유한 재고
