/* =========================================================
   가짜 사주 엔진
   ========================================================= */
function hashStr(s){let h=2166136261>>>0;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function todayKey(d){d=d||new Date();return `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`;}
function rollGrade(rng,total,wealth){const lux=(total+wealth)/200,r=rng();
  if(r>0.985-lux*0.02)return 4; if(r>0.93-lux*0.06)return 3; if(r>0.78-lux*0.12)return 2; if(r>0.45-lux*0.10)return 1; return 0;}
const ELEMENT_SHIFT=[-2,-1,0,1,2];   // 색(오행)별 등급 보정: 목 -2 … 수 +2
function clampGrade(x){ return Math.max(0,Math.min(4,x)); }
function gradeOf(baseIdx,colorIdx){ return clampGrade((BASE[baseIdx]?BASE[baseIdx].grade:0) + ELEMENT_SHIFT[colorIdx]); }  // 외형×색 = 고유 등급
function basesOfGrade(g){ return BASE.map((b,i)=>b.grade===g?i:-1).filter(i=>i>=0); }
function pickBaseOfGrade(rng,g){ const a=basesOfGrade(g); return a.length?a[Math.floor(rng()*a.length)]:0; }
function itemsOfGrade(g){ const out=[]; for(let b=0;b<BASE.length;b++) for(let e=0;e<ELEMENTS.length;e++) if(gradeOf(b,e)===g) out.push([b,e]); return out; }
function pickItemOfGrade(rng,g){ let a=itemsOfGrade(g); if(!a.length){ for(let d=1;d<=4&&!a.length;d++){ a=itemsOfGrade(clampGrade(g-d)).concat(itemsOfGrade(clampGrade(g+d))); } } return a.length?a[Math.floor(rng()*a.length)]:[0,2]; }
function pickBaseForGradeColor(rng,g,color){   // 색은 고정(행운색), 그 색에서 목표 등급에 맞는 외형
  const exact=BASE.map((b,i)=>gradeOf(i,color)===g?i:-1).filter(i=>i>=0);
  if(exact.length) return exact[Math.floor(rng()*exact.length)];
  let best=0,bd=99; for(let i=0;i<BASE.length;i++){ const d=Math.abs(gradeOf(i,color)-g); if(d<bd){bd=d;best=i;} } return best;
}
function makeItem(baseIdx,colorIdx){
  const b=BASE[baseIdx],el=ELEMENTS[colorIdx];
  return {base:b.name,glyph:b.glyph,name:el.prefix+" "+b.name,element:colorIdx,grade:gradeOf(baseIdx,colorIdx),tags:{sale:b.sale,attr:el.key}};
}
function computeFortune(dayKey){
  const b=gameState.player.birth, sig=`${b.year}-${b.month}-${b.day}-${b.hour}`;
  const rng=mulberry32(hashStr(sig+"|"+dayKey+"|"+gameState.player.nickname));
  const stat=()=>{const r=(rng()+rng())/2;return Math.round(15+r*84);};
  const stats={total:stat(),wealth:stat(),relation:stat(),health:stat()};
  const colorIdx=Math.floor(rng()*5), luckyNumber=Math.floor(rng()*10);
  const grade=rollGrade(rng,stats.total,stats.wealth);
  const item=makeItem(pickBaseForGradeColor(rng,grade,colorIdx),colorIdx);
  return {stats,colorIdx,luckyNumber,item};
}
function fortuneComment(t){
