const SFX=(()=>{
  let ac=null, master=null;
  let muted=(()=>{ try{ return localStorage.getItem("destinyShop.muted")==="1"; }catch(e){ return false; } })();
  function ctx(){
    if(!ac){ try{ const AC=window.AudioContext||window.webkitAudioContext; ac=new AC(); master=ac.createGain(); master.gain.value=0.42; master.connect(ac.destination); }catch(e){ return null; } }
