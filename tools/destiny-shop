/* ---- 액운 역발상(Phase 4) ---- */
const WARD_THRESHOLD=45, WARD_TAG="건강운", WARD_MULT=2.5, WARD_PENALTY=0.85;   // 흉일: 액막이(건강운) ×2.5 대목 / 그 외 -15% · 손님 조급
