const shop={ slots:[null,null,null], queue:[], front:null, combo:0, served:0, sessionGold:0, running:false, lastTs:0 };
const slotRow=document.getElementById("slotRow"), invRow=document.getElementById("invRow"),
      frontWrap=document.getElementById("frontWrap"), custQueue=document.getElementById("custQueue"), custStage=document.getElementById("custStage");

function enterShop(){
  const n=slotCount();
  shop.slots=Array.from({length:n},(_,i)=>{ const id=gameState.display.slots[i]; return id?lookupStack(id):null; });
  gameState.display.slots=shop.slots.map(s=>s?s.id:null); persist();
  shop.queue=[]; shop.front=null; shop.combo=0; shop.served=0; shop.sessionGold=0;
  document.getElementById("slotLabel").textContent=`· 전면 ${n}칸`;
  const sw=document.getElementById("shopWard");
  if(isWardDay()){ sw.hidden=false; sw.innerHTML=`🜂 <b>액운의 날</b> · 액막이 <b>#${WARD_TAG}</b> ×${WARD_MULT} · 그 외 -15% · 손님 조급`; }
  else sw.hidden=true;
  renderSlots(); renderInventory(); updateSessionStats();
  if(totalStock()===0){
    stopShop(); custQueue.innerHTML="";
    frontWrap.innerHTML=`<div class="shop-empty">판매할 재고가 없어요.<br><b>운세</b> 탭에서 오늘의 행운 아이템을 받아오세요.</div>`;
    return;
  }
  for(let i=0;i<4;i++) shop.queue.push(makeCustomer());
  shop.front=shop.queue.shift(); shop.front.preStocked=isCovered(shop.front.demand);
  renderQueue(); renderFront("want"); startShop();
}
function makeCustomer(){
  const vip=Math.random()<0.12; let pMax=(vip?6:8)+patienceBonus();
  if(isWardDay()) pMax=Math.max(4, pMax-1);   // 흉일: 손님이 조급해짐
  const demand=(isWardDay()&&Math.random()<0.5)?WARD_TAG:pick(SALE_TAGS);
  return {demand,vip,avatar:vip?"🤵":pick(AVATARS),patience:pMax,patienceMax:pMax,selling:false,done:false,sellAt:0,preStocked:false};
}
function isCovered(tag){ return shop.slots.some(s=>s&&s.tags.sale===tag); }
function matchingSlotIndex(tag){ return shop.slots.findIndex(s=>s&&s.tags.sale===tag); }

function renderSlots(){
  const demand=shop.front?shop.front.demand:null;
  slotRow.innerHTML=shop.slots.map((s,i)=>{
    if(!s) return `<button class="slot empty" data-slot="${i}"><span class="slot-empty">＋</span><span class="slot-name">빈 슬롯</span></button>`;
    const match=demand&&s.tags.sale===demand;
    return `<button class="slot filled ${match?'match':''}" data-slot="${i}"><span class="slot-glyph">${s.glyph}</span><span class="slot-name">${s.name}</span><span class="slot-tag">#${s.tags.sale} · ×${s.qty}</span></button>`;
  }).join("");
}
function renderInventory(){
  const demand=shop.front?shop.front.demand:null;
  if(!gameState.inventory.length){ invRow.innerHTML=`<div class="empty-inv">재고가 없습니다 · 운세에서 받아오세요</div>`; return; }
  invRow.innerHTML=gameState.inventory.map(it=>{
    const g=GRADES[it.grade], hot=demand&&it.tags.sale===demand;
    return `<button class="inv-item ${hot?'hot':''}" data-id="${it.id}"><span class="grade-dot" style="background:${g.color}"></span><span class="inv-glyph">${it.glyph}</span><span class="inv-name">${it.name}</span><span class="inv-tag">#${it.tags.sale} · ×${it.qty}</span></button>`;
  }).join("");
}
function syncSlots(){ gameState.display.slots=shop.slots.map(s=>s?s.id:null); persist(); }
function placeAt(st,i){ shop.slots[i]=st; SFX.play("place"); syncSlots(); renderSlots(); renderInventory(); const el=slotRow.children[i]; if(el&&!reducedMotion){el.classList.add("pop");setTimeout(()=>el.classList.remove("pop"),350);} }
let autoDispTimer=null;
function scheduleAutoDisplay(){
  clearTimeout(autoDispTimer);
  const lv=staffLv("display"); if(lv<=0) return;
  const c=shop.front; if(!c||c.done) return;
  autoDispTimer=setTimeout(()=>{
    const cur=shop.front; if(!cur||cur.done||cur!==c) return;     // 같은 손님이 아직 대기 중일 때만
    if(isCovered(cur.demand)) return;                              // 이미 진열돼 있으면 패스
    const st=gameState.inventory.find(it=>it.tags.sale===cur.demand);
    if(!st) return;                                                // 인벤토리에 매칭 재고 없음
    const empty=shop.slots.findIndex(s=>!s);
    if(empty<0) return;                                            // 빈 슬롯 없음
    placeAt(st, empty);                                            // 자동 진열 → 자동 판매로 이어짐
  }, STAFF_DISPLAY_DELAY[lv]);
}
function placeSmart(st){
  let i=shop.slots.indexOf(null);
  if(i===-1){ const demand=shop.front?shop.front.demand:null; i=shop.slots.findIndex(s=>!demand||s.tags.sale!==demand); if(i===-1)i=0; }
  placeAt(st,i);
}
function emptySlot(i){ shop.slots[i]=null; syncSlots(); renderSlots(); renderInventory(); }

slotRow.addEventListener("click",e=>{ const b=e.target.closest(".slot"); if(!b)return; const i=+b.dataset.slot; if(shop.slots[i]) emptySlot(i); });
frontWrap.addEventListener("click",e=>{ if(e.target.closest("#dismissBtn")) dismissCustomer(); });

/* 인벤토리 → 진열대 드래그(터치/마우스) + 탭 단축 */
let drag=null; const DRAG_THRESHOLD=7;
function clearDragOver(){ slotRow.querySelectorAll(".slot.drag-over").forEach(s=>s.classList.remove("drag-over")); }
function endDrag(){ if(drag){ if(drag.ghost)drag.ghost.remove(); if(drag.source)drag.source.classList.remove("dragging-src"); } document.body.classList.remove("dragging"); clearDragOver(); drag=null; }
invRow.addEventListener("pointerdown",e=>{
  if(drag&&drag.started)return;
  const b=e.target.closest(".inv-item"); if(!b)return;
  const st=lookupStack(b.dataset.id); if(!st)return;
  drag={ item:st, source:b, x0:e.clientX, y0:e.clientY, ptype:e.pointerType, started:false, pending:true, ghost:null, pid:e.pointerId };
});
invRow.addEventListener("pointermove",e=>{
  if(!drag||!drag.pending)return;
  const dx=e.clientX-drag.x0, dy=e.clientY-drag.y0;
  if(!drag.started){
    if(drag.ptype!=="mouse" && Math.abs(dx)>Math.abs(dy)){ drag=null; return; }
    if(Math.hypot(dx,dy)<DRAG_THRESHOLD) return;
    drag.started=true;
    try{ invRow.setPointerCapture(drag.pid); }catch(_){}
    drag.source.classList.add("dragging-src");
    const g=document.createElement("div"); g.className="drag-ghost";
    g.innerHTML=`<span class="inv-glyph">${drag.item.glyph}</span><span class="inv-name">${drag.item.name}</span><span class="inv-tag">#${drag.item.tags.sale}</span>`;
    document.body.appendChild(g); drag.ghost=g; document.body.classList.add("dragging");
  }
  if(drag.started){
    e.preventDefault();
    drag.ghost.style.left=e.clientX+"px"; drag.ghost.style.top=e.clientY+"px";
    const el=document.elementFromPoint(e.clientX,e.clientY), slot=el?el.closest(".slot"):null;
    clearDragOver(); if(slot) slot.classList.add("drag-over");
  }
},{passive:false});
invRow.addEventListener("pointerup",e=>{
  if(!drag)return;
  if(drag.started){ const el=document.elementFromPoint(e.clientX,e.clientY), slot=el?el.closest(".slot"):null; if(slot) placeAt(drag.item,+slot.dataset.slot); endDrag(); }
  else if(drag.pending){ placeSmart(drag.item); drag=null; }
  else drag=null;
});
invRow.addEventListener("pointercancel",endDrag);

/* 손님 줄 / 앞손님 */
function renderQueue(){ custQueue.innerHTML=shop.queue.map(c=>`<div class="qav ${c.vip?'vip':''}">${c.avatar}</div>`).join(""); }
function renderFront(state){
  const c=shop.front; if(!c){ frontWrap.innerHTML=""; return; }
  let bubble,showBar=true;
  if(state==="selling"){bubble=`거래 중…`;}
  else if(state==="happy"){bubble=`고마워요!`;showBar=false;}
  else if(state==="angry"){bubble=`에잇, 다음에…`;showBar=false;}
  else if(state==="bye"){bubble=`다음에 올게요…`;showBar=false;}
  else {bubble=`#${c.demand} <em>급구!</em>`;}
  const av=state==="happy"?"😊":state==="angry"?"😠":c.avatar;
  const canServe=gameState.inventory.some(it=>it.tags.sale===c.demand);
  frontWrap.innerHTML=`<div class="front-cust ${c.vip?'vip':''}">${c.vip?'<div class="vip-crown">👑</div>':''}<div class="bubble ${state}">${bubble}</div><div class="cust-av">${av}</div><div class="patience${showBar?'':' invis'}"><i id="custBar"></i></div><div class="dismiss-slot">${state==="want"?`<button class="dismiss-btn ${canServe?'':'suggest'}" id="dismissBtn">내보내기</button>`:''}</div></div>`;
  if(state==="want") scheduleAutoDisplay();
}
function updateBar(){ const bar=document.getElementById("custBar"); if(!bar||!shop.front)return; const r=Math.max(0,shop.front.patience/shop.front.patienceMax); bar.style.width=(r*100)+"%"; bar.style.background=r>0.5?"var(--good)":r>0.25?"var(--gold)":"var(--danger)"; }
function updateSessionStats(){ document.getElementById("ssGold").textContent=shop.sessionGold.toLocaleString(); document.getElementById("ssServed").textContent=shop.served; const m=1+Math.min(shop.combo,10)*0.1; document.getElementById("ssCombo").textContent=m.toFixed(1)+"×"; }

function finalizeSale(c){
  const idx=matchingSlotIndex(c.demand); if(idx===-1){ c.selling=false; return; }
  const item=shop.slots[idx];
  let price=PRICE[item.grade], bonuses=[];
  const comboMult=1+Math.min(shop.combo,10)*0.1;
  if(c.preStocked){ price*=1.25; bonuses.push("준비된 진열"); }
  const f=gameState.daily.fortune;
  if(f && item.element===f.colorIdx){ price*=1.2; bonuses.push("행운색"); }
  if(c.vip){ price*=VIP_MULT; bonuses.push("VIP"); }
  const mm=marginMult(); if(mm>1){ price*=mm; bonuses.push("시설"); }
  let wardPenalty=false;
  if(isWardDay()){
    if(item.tags.sale===WARD_TAG){ price*=WARD_MULT; bonuses.push("액막이 특수"); }
    else { price*=WARD_PENALTY; wardPenalty=true; }
  }
  price=Math.round(price*comboMult);
  shop.combo++; shop.served++; shop.sessionGold+=price;
  gameState.currency.gold+=price;
  gameState.shop.salesGold+=price; gameState.shop.salesUnits+=1;   // 평균 산출용
  consumeStock(item,1);                                            // 재고 1 차감 (소진 시 슬롯 비움)
  persist();
  c.done=true;
  SFX.play(c.vip?"saleVip":"sale");
  floatGold(price,bonuses,wardPenalty); renderFront("happy"); reactAvatar();
  renderSlots(); renderInventory(); updateSessionStats();
  setTimeout(advanceQueue,520);
}
function timeoutCustomer(c){ c.done=true; shop.combo=0; updateSessionStats(); SFX.play("angry"); renderFront("angry"); setTimeout(advanceQueue,520); }
function dismissCustomer(){ const c=shop.front; if(!c||c.done)return; c.done=true; shop.combo=0; updateSessionStats(); SFX.play("whoosh"); renderFront("bye"); setTimeout(advanceQueue,360); }
function advanceQueue(){ shop.queue.push(makeCustomer()); shop.front=shop.queue.shift(); shop.front.preStocked=isCovered(shop.front.demand); renderQueue(); renderFront("want"); renderSlots(); renderInventory(); }
function reactAvatar(){ const av=frontWrap.querySelector(".cust-av"); if(av&&!reducedMotion){av.classList.add("react");setTimeout(()=>av.classList.remove("react"),200);} }
function floatGold(amount,bonuses,penalty){ const el=document.createElement("div"); el.className="float-gold"; el.innerHTML=`<div class="fg-main">+${amount.toLocaleString()}냥</div>`+(bonuses.length?`<div class="fg-bonus">${bonuses.join(" · ")}</div>`:"")+(penalty?`<div class="fg-pen">흉일 -15%</div>`:""); custStage.appendChild(el); setTimeout(()=>el.remove(),1000); }
function tick(dt){
  gameState.shop.activeMs += dt*1000;            // 활성 시간 누적 (평균 수익률 산출)
  const c=shop.front; if(!c||c.done)return;
  if(isCovered(c.demand)){
    if(!c.selling){ c.selling=true; c.sellAt=performance.now()+450; renderFront("selling"); }
    if(performance.now()>=c.sellAt) finalizeSale(c);
  }else{
    if(c.selling){ c.selling=false; renderFront("want"); }
    c.patience-=dt; if(c.patience<=0){ timeoutCustomer(c); return; } updateBar();
  }
}
function startShop(){ if(shop.running)return; shop.running=true; shop.lastTs=performance.now(); requestAnimationFrame(loop); }
function stopShop(){ if(shop.running) persist(); shop.running=false; }
function loop(ts){ if(!shop.running)return; const dt=(ts-shop.lastTs)/1000; shop.lastTs=ts; tick(Math.min(dt,0.1)); requestAnimationFrame(loop); }

/* =========================================================
   성장 (Phase 3)
   ========================================================= */
const growthBody=document.getElementById("growthBody");
function hotTagForTomorrow(){ const t=new Date(Date.now()+86400000); const rng=mulberry32(hashStr("market|"+todayKey(t))); return SALE_TAGS[Math.floor(rng()*SALE_TAGS.length)]; }
function marketHint(){ return `내일은 시장에 <b>#${hotTagForTomorrow()}</b>의 기운이 무르익습니다. 관련 물품을 미리 챙겨두면 좋아요.`; }
function renderGrowth(){
  document.getElementById("gGold").textContent=gameState.currency.gold.toLocaleString();
  const st=gameState.shop.stage, gold=gameState.currency.gold; let html="";
