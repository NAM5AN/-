  }
  function tone(freq,dur,o){ o=o||{}; const c=ctx(); if(!c)return; const t=c.currentTime+(o.when||0);
    const osc=c.createOscillator(), g=c.createGain(); osc.type=o.type||"sine"; osc.frequency.setValueAtTime(freq,t); if(o.detune)osc.detune.value=o.detune;
    const end=t+dur; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(o.gain||0.2,t+(o.attack||0.006)); g.gain.exponentialRampToValueAtTime(0.0001,end);
    osc.connect(g).connect(master); osc.start(t); osc.stop(end+0.03);
  }
  function sweep(f1,f2,dur,o){ o=o||{}; const c=ctx(); if(!c)return; const t=c.currentTime+(o.when||0);
    const osc=c.createOscillator(), g=c.createGain(); osc.type=o.type||"sine";
    osc.frequency.setValueAtTime(f1,t); osc.frequency.exponentialRampToValueAtTime(Math.max(1,f2),t+dur);
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(o.gain||0.18,t+0.012); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    osc.connect(g).connect(master); osc.start(t); osc.stop(t+dur+0.03);
  }
  function noise(dur,o){ o=o||{}; const c=ctx(); if(!c)return; const t=c.currentTime+(o.when||0);
    const n=Math.max(1,Math.floor(c.sampleRate*dur)), buf=c.createBuffer(1,n,c.sampleRate), d=buf.getChannelData(0);
    for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*(1-i/n);
    const src=c.createBufferSource(); src.buffer=buf;
    const f=c.createBiquadFilter(); f.type=o.filter||"bandpass"; f.frequency.value=o.freq||1500; f.Q.value=o.q||0.8;
    const g=c.createGain(); g.gain.setValueAtTime(o.gain||0.12,t); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    src.connect(f).connect(g).connect(master); src.start(t); src.stop(t+dur);
  }
  const seq=(notes,o)=>{ o=o||{}; notes.forEach((f,i)=>tone(f,o.dur||0.13,Object.assign({type:"triangle",gain:0.16,when:i*(o.step||0.06)},o.tone||{}))); };
  const lib={
    tap(){ tone(420,0.05,{type:"triangle",gain:0.09}); },
    place(){ tone(523,0.07,{type:"triangle",gain:0.22}); tone(784,0.12,{type:"triangle",gain:0.18,when:0.055}); },
    sale(){ seq([660,880,1320],{dur:0.12,step:0.055}); },                                   // 판매 성공
    saleVip(){ seq([523,659,784,1047,1319],{dur:0.16,step:0.05}); tone(1568,0.3,{type:"sine",gain:0.07,when:0.26}); }, // VIP 판매
    coin(){ tone(988,0.05,{type:"square",gain:0.10}); tone(1319,0.13,{type:"square",gain:0.10,when:0.05}); },       // 매입/골드
    angry(){ tone(165,0.18,{type:"sawtooth",gain:0.15}); tone(150,0.22,{type:"sawtooth",gain:0.13,when:0.06}); },    // 손님 화남
    upgrade(){ seq([392,523,659,880],{dur:0.18,step:0.06}); },                              // 업그레이드/구매
    error(){ tone(220,0.1,{type:"square",gain:0.12}); tone(175,0.12,{type:"square",gain:0.12,when:0.09}); },         // 불가/부족
    reveal(){ sweep(440,1180,0.45,{type:"sine",gain:0.12}); tone(1760,0.4,{type:"sine",gain:0.06,when:0.22}); },     // 운세 공개
    rare(){ seq([659,988,1319,1760],{dur:0.26,step:0.075,tone:{type:"triangle",gain:0.15}}); tone(2093,0.5,{type:"sine",gain:0.06,when:0.34}); }, // 고등급 획득
    flip(){ noise(0.12,{filter:"bandpass",freq:1900,q:0.7,gain:0.11}); tone(700,0.06,{type:"sine",gain:0.08,when:0.02}); }, // 카드 뒤집기
    receive(){ seq([880,1175,1568],{dur:0.1,step:0.045,tone:{type:"triangle",gain:0.12}}); noise(0.22,{filter:"highpass",freq:2600,gain:0.05,when:0.02}); }, // 받기/수령
    whoosh(){ noise(0.18,{filter:"highpass",freq:500,gain:0.10}); }                          // 내보내기
  };
  function play(name){ if(muted)return; const fn=lib[name]; if(fn){ try{ fn(); }catch(e){} } }
  return { play, unlock(){ ctx(); }, isMuted(){ return muted; }, toggle(){ muted=!muted; try{ localStorage.setItem("destinyShop.muted",muted?"1":"0"); }catch(e){} if(!muted) ctx(); return muted; } };
})();
