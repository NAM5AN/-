  if(t>=60)return "순조로운 흐름입니다. 평소처럼 차분히 운영하기 좋아요.";
  if(t>=40)return "잔잔한 하루. 무리하지 말고 <b>재고를 정리</b>하기 좋은 날.";
  return "총운은 낮지만 — <b>역발상이 빛나는 날</b>입니다. 평소와 다른 카테고리를 노려보세요.";
}

/* ---- 인벤토리(스택) ---- */
function itemKey(t){ return `${t.base}|${t.element}|${t.grade}`; }
function lookupStack(id){ return gameState.inventory.find(it=>it.id===id)||null; }
function codexAdd(t){ const bi=BASE.findIndex(b=>b.name===t.base); if(bi<0)return; if(!gameState.codex)gameState.codex=[]; const key=bi+"|"+t.element; if(!gameState.codex.includes(key)) gameState.codex.push(key); }
function addToInventory(t, qty){
  codexAdd(t);
  const k=itemKey(t), st=gameState.inventory.find(it=>itemKey(it)===k);
  if(st){ st.qty+=qty; }
  else gameState.inventory.push({ id:uid(), base:t.base, glyph:t.glyph, name:t.name, element:t.element, grade:t.grade, tags:{...t.tags}, qty });
}
function removeStack(st){
  const i=gameState.inventory.indexOf(st); if(i!==-1) gameState.inventory.splice(i,1);
  shop.slots=shop.slots.map(s=>s===st?null:s);
  gameState.display.slots=gameState.display.slots.map(id=>id===st.id?null:id);
}
function consumeStock(st,n){ st.qty-=n; if(st.qty<=0) removeStack(st); }

