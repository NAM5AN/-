    const acost=RAIL_ADD_COST[rc+1], aok=gold>=acost;
    html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">레일 추가 (${rc} → ${rc+1})</div><div class="grow-cost ${aok?'':'short'}">${acost.toLocaleString()}냥</div></div><div class="grow-eff">동시에 자동생산하는 레일이 1개 늘어납니다</div><button class="grow-btn" data-rail="add" ${aok?'':'disabled'}>${aok?'레일 추가':'재화 부족'}</button></div>`;
  }else html+=`<div class="grow-card"><div class="grow-eff" style="text-align:center;margin:0">레일 최대 ${MAX_RAILS}개 보유 중</div></div>`;
  // 레일 속도 (레일별 · 비용 기하급수)
  gameState.factory.rails.forEach((r,i)=>{
    const lv=railLevel(r), max=lv>=MAX_RAIL_LEVEL;
    const label = r.item ? r.item.name : "빈 레일";
    if(max){
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">레일 ${i+1} 속도 · Lv.${lv}</div><div class="grow-owned">최고 속도</div></div><div class="grow-eff" style="margin:0">${label} · 생산 속도 ×${railSpeedMult(lv).toFixed(2)}</div></div>`;
    }else{
      const c=railSpeedCost(lv), ok=gold>=c;
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">레일 ${i+1} 속도 · Lv.${lv}</div><div class="grow-cost ${ok?'':'short'}">${c.toLocaleString()}냥</div></div><div class="grow-eff">${label} · 생산 속도 ×${railSpeedMult(lv).toFixed(2)} → <b>×${railSpeedMult(lv+1).toFixed(2)}</b></div><button class="grow-btn" data-railspeed="${i}" ${ok?'':'disabled'}>${ok?'속도 강화':'재화 부족'}</button></div>`;
    }
  });
  html+=`<div class="grow-label">아르바이트</div>`;
  { // 진열 도우미
    const lv=staffLv("display"), cur=(STAFF_DISPLAY_DELAY[lv]||0)/1000;
    if(lv>=STAFF_MAX){
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">🧑‍💼 진열 도우미 · Lv.${lv}</div><div class="grow-owned">최고</div></div><div class="grow-eff" style="margin:0">요구 태그 아이템 자동 진열 · 반응 ${cur}s (최고)</div></div>`;
    }else{
      const c=STAFF_COST.display[lv], ok=gold>=c, nx=STAFF_DISPLAY_DELAY[lv+1]/1000;
      const eff = lv===0 ? `손님이 원하는 태그가 진열대에 없으면 인벤토리에서 자동으로 진열` : `자동 진열 반응 ${cur}s → <b>${nx}s</b> · 더 빨리 응대`;
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">🧑‍💼 진열 도우미 · Lv.${lv}</div><div class="grow-cost ${ok?'':'short'}">${c.toLocaleString()}냥</div></div><div class="grow-eff">${eff}</div><button class="grow-btn" data-staff="display" ${ok?'':'disabled'}>${lv===0?'고용하기':(ok?'레벨업':'재화 부족')}</button></div>`;
    }
  }
  { // 자동 수령원
    const lv=staffLv("collector"), cur=Math.round((STAFF_COLLECT_RATIO[lv]||0)*100);
    if(lv>=STAFF_MAX){
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">🏭 자동 수령원 · Lv.${lv}</div><div class="grow-owned">최고</div></div><div class="grow-eff" style="margin:0">공장 생산물 자동 수령 · 누적 ${cur}%↑ (최고)</div></div>`;
    }else{
      const c=STAFF_COST.collector[lv], ok=gold>=c, nx=Math.round(STAFF_COLLECT_RATIO[lv+1]*100);
      const eff = lv===0 ? `공장 레일에 쌓인 아이템을 주기적으로 자동 수령(생산이 멈추지 않음)` : `자동 수령 기준 누적 ${cur}% → <b>${nx}%</b> · 더 자주 수령`;
      html+=`<div class="grow-card"><div class="grow-row"><div class="grow-up">🏭 자동 수령원 · Lv.${lv}</div><div class="grow-cost ${ok?'':'short'}">${c.toLocaleString()}냥</div></div><div class="grow-eff">${eff}</div><button class="grow-btn" data-staff="collector" ${ok?'':'disabled'}>${lv===0?'고용하기':(ok?'레벨업':'재화 부족')}</button></div>`;
    }
  }
  html+=`<div class="grow-label">내일 시세</div><div class="grow-card hint">${marketHint()}</div>`;
  html+=`<button class="grow-test" id="idleTestBtn">테스트: 1시간 방치 수익 받기</button>`;
  growthBody.innerHTML=html;
}
growthBody.addEventListener("click",e=>{
  const up=e.target.closest("[data-up]"), buy=e.target.closest("[data-buy]"), rail=e.target.closest("[data-rail]"), rsp=e.target.closest("[data-railspeed]"), stf=e.target.closest("[data-staff]"), test=e.target.closest("#idleTestBtn");
  if(up){
    const next=gameState.shop.stage+1, cost=STAGE_COST[next];
    if(gameState.shop.stage<MAX_STAGE && gameState.currency.gold>=cost){ gameState.currency.gold-=cost; gameState.shop.stage=next; persist(); SFX.play("upgrade"); renderGrowth(); showToast(`${SHOP_STAGE_NAMES[next]}(으)로 성장!`); }
  }else if(buy){
    const f=FACILITIES.find(x=>x.id===buy.dataset.buy);
    if(f && !hasFacility(f.id) && gameState.currency.gold>=f.cost){ gameState.currency.gold-=f.cost; gameState.shop.facilities.push(f.id); persist(); SFX.play("upgrade"); renderGrowth(); showToast(`${f.name} 설치 완료`); }
  }else if(rail){
    if(rail.dataset.rail==="tier"){
      const nt=railTier()+1, c=RAIL_TIER_COST[nt];
      if(railTier()<5 && gameState.currency.gold>=c){ gameState.currency.gold-=c; gameState.factory.railTier=nt; persist(); SFX.play("upgrade"); renderGrowth(); showToast(`${GRADES[nt-1].name} 등급 제작 해금!`); }
    }else if(rail.dataset.rail==="add"){
      const rc=railCount(), c=RAIL_ADD_COST[rc+1];
      if(rc<MAX_RAILS && gameState.currency.gold>=c){ gameState.currency.gold-=c; gameState.factory.rails.push({item:null, since:Date.now(), level:1}); persist(); SFX.play("upgrade"); renderGrowth(); showToast("레일을 추가했어요"); }
    }
  }else if(rsp){
    const i=+rsp.dataset.railspeed, r=gameState.factory.rails[i];
    if(r){ const lv=railLevel(r), c=railSpeedCost(lv);
      if(lv<MAX_RAIL_LEVEL && gameState.currency.gold>=c){
        // 진행 중인 누적 비율을 보존한 채 속도만 올림
        if(r.item){ const p=railProgress(r); r.since=Date.now()-Math.floor(p*PROD_SEC[r.item.grade]*1000*Math.pow(SPEED_BASE, lv)); }
        gameState.currency.gold-=c; r.level=lv+1; persist(); SFX.play("upgrade"); renderGrowth(); showToast(`레일 ${i+1} 속도 Lv.${lv+1}`);
      }
    }
  }else if(stf){
    const k=stf.dataset.staff, lv=staffLv(k), nm=k==="display"?"진열 도우미":"자동 수령원";
    if(lv<STAFF_MAX){ const c=STAFF_COST[k][lv];
      if(gameState.currency.gold>=c){ gameState.currency.gold-=c; if(!gameState.staff)gameState.staff={display:0,collector:0}; gameState.staff[k]=lv+1; persist(); SFX.play("upgrade"); renderGrowth(); showToast(`${nm} ${lv===0?'고용 완료':'Lv.'+(lv+1)}`); }
    }
  }else if(test){
    gameState.meta.lastSeenAt=Date.now()-3600*1000;
    const inc=checkOfflineIncome(true);
    if(!inc) showToast("먼저 상점에서 판매해 평균 수익을 쌓아주세요");
  }
});

/* ---- 방치 수익 정산 (활성 평균 수익률 기반 · 재고 차감) ---- */
let pendingClaim=0;
function fmtDuration(ms){ const tot=Math.floor(ms/60000),h=Math.floor(tot/60),m=tot%60; return h>0?`${h}시간 ${m}분`:`${m}분`; }
function sellOneRandom(){
  const pool=gameState.inventory.filter(it=>it.qty>0); if(!pool.length)return;
  const st=pool[Math.floor(Math.random()*pool.length)]; consumeStock(st,1);
}
function checkOfflineIncome(force){
  const now=Date.now(), prev=gameState.meta.lastSeenAt||now, elapsed=now-prev;
  gameState.meta.lastSeenAt=now;
  if(!gameState.meta.onboarded || (!force && elapsed<IDLE_MIN_MS)){ persist(); return 0; }
  const sh=gameState.shop;
  const avgUnit = sh.salesUnits>0 ? sh.salesGold/sh.salesUnits : 0;
  const activeH = sh.activeMs/3600000;
  const unitsPerHour = activeH>0 ? sh.salesUnits/activeH : 0;
  const cappedH=Math.min(elapsed/3600000, MAX_IDLE_HOURS);
  let units=Math.round(unitsPerHour*IDLE_PERCENT*idleFacMult()*cappedH);
  units=Math.min(units, totalStock());
  if(units<=0 || avgUnit<=0){ persist(); return 0; }
  for(let k=0;k<units && totalStock()>0;k++) sellOneRandom();   // 재고 차감
  const income=Math.round(units*avgUnit);
  gameState.currency.gold+=income; persist();
  showClaim(income, elapsed, units);
  return income;
}
function showClaim(income, elapsed, units){
  pendingClaim=income;
  document.getElementById("claimAway").textContent=`상점을 비운 ${fmtDuration(elapsed)} 동안 손님이 ${units}개를 사갔어요`;
  document.getElementById("claimAmount").textContent=income.toLocaleString();
  document.getElementById("claimNote").textContent=(elapsed/3600000>MAX_IDLE_HOURS)?`방치 수익은 최대 ${MAX_IDLE_HOURS}시간까지 쌓여요`:"";
  document.getElementById("claimModal").hidden=false;
}
function closeClaim(extra){
  SFX.play(extra>0?"coin":"receive");
  if(extra>0){ gameState.currency.gold+=pendingClaim*extra; persist(); showToast(`+${(pendingClaim*extra).toLocaleString()}냥 추가`); }
  document.getElementById("claimModal").hidden=true; pendingClaim=0;
  if(document.getElementById("growth").classList.contains("active")) renderGrowth();
}
document.getElementById("claimBtn").addEventListener("click",()=>closeClaim(0));
document.getElementById("claimX2Btn").addEventListener("click",()=>closeClaim(1));

/* ---- 떠남/복귀 기록 ---- */
document.addEventListener("visibilitychange",()=>{ if(document.hidden){ gameState.meta.lastSeenAt=Date.now(); persist(); } else checkOfflineIncome(false); });
window.addEventListener("pagehide",()=>{ gameState.meta.lastSeenAt=Date.now(); persist(); });

/* =========================================================
   시장 (매입) — NPC/타 유저 매물, 매일 갱신 · 재고 한정
   ========================================================= */
const marketBody=document.getElementById("marketBody");
function makeOffer(rng,i){
  const grade=rollMarketGrade(rng);
  const p=pickItemOfGrade(rng,grade); const it=makeItem(p[0],p[1]);
  const factor=0.9+rng()*0.2;
  const price=Math.max(1,Math.round(PRICE[grade]*MARKET_BUY_RATE*factor));
  const [lo,hi]=MARKET_STOCK[grade]; const stock=lo+Math.floor(rng()*(hi-lo+1));
  const m=MERCHANTS[Math.floor(rng()*MERCHANTS.length)];
  return { id:"of"+i+"_"+Math.floor(rng()*1e6).toString(36), merchant:m.n, mico:m.e, base:it.base, glyph:it.glyph, name:it.name, element:it.element, grade, tags:it.tags, price, stock };
}
function ensureMarket(){
  const today=todayKey();
  if(gameState.market && gameState.market.date===today && gameState.market.offers.length) return;
  const rng=mulberry32(hashStr("market|"+today+"|"+(gameState.player.nickname||"")));
  const offers=[]; for(let i=0;i<MARKET_SIZE;i++) offers.push(makeOffer(rng,i));
  gameState.market={date:today, offers, rerolls:0}; persist();
}
function rerollMarket(){
  ensureMarket();
  if((gameState.market.rerolls||0)>=MARKET_REROLL_MAX){ SFX.play("error"); showToast("오늘 리롤을 모두 썼어요"); return; }
  const n=(gameState.market.rerolls||0)+1;
  const rng=mulberry32(hashStr("market|"+todayKey()+"|"+(gameState.player.nickname||"")+"|r"+n+"|"+Date.now()));
  const offers=[]; for(let i=0;i<MARKET_SIZE;i++) offers.push(makeOffer(rng,i));
  gameState.market.offers=offers; gameState.market.rerolls=n; persist();
  SFX.play("upgrade"); renderMarket();
  showToast(`새 매물 도착 · 리롤 ${n}/${MARKET_REROLL_MAX}`);
}
function renderMarket(){
  ensureMarket();
  document.getElementById("mGold").textContent=gameState.currency.gold.toLocaleString();
  const left=gameState.market.offers.reduce((s,o)=>s+o.stock,0);
  const rleft=MARKET_REROLL_MAX-(gameState.market.rerolls||0);
  let html=`<div class="mkt-head">🌙 자정에 새 매물이 들어옵니다 · 남은 매물 <b>${left}</b>개<br><span>대부분 낮은 등급 · 드물게 고급 매물 등장 — 사서 더 비싸게 파세요</span></div>`;
  html+=`<button class="mkt-reroll" id="mktRerollBtn" ${rleft>0?'':'disabled'}>🎬 광고 보고 매물 새로고침 <small>(${rleft}/${MARKET_REROLL_MAX})</small></button>`;
  gameState.market.offers.forEach(o=>{
    const g=GRADES[o.grade], sold=o.stock<=0, ok=gameState.currency.gold>=o.price && !sold, rare=o.grade>=2 && !sold;
    html+=`<div class="mkt-card ${sold?'sold':''} ${rare?'rare':''}"><div class="mkt-merchant">${o.mico} ${o.merchant}</div><div class="mkt-body"><span class="mkt-glyph">${o.glyph}</span><div class="mkt-info"><div class="mkt-name">${o.name} <span class="mkt-grade" style="background:${g.color}">${g.name}</span></div><div class="mkt-tag">#${o.tags.sale} · 재고 ×${o.stock}</div></div></div><div class="mkt-foot"><div class="mkt-price">매입 <b>${o.price.toLocaleString()}</b>냥 <small>→ 판매 ${PRICE[o.grade].toLocaleString()}냥~</small></div><button class="mkt-buy" data-offer="${o.id}" ${ok?'':'disabled'}>${sold?'품절':'구매'}</button></div></div>`;
  });
  marketBody.innerHTML=html;
}
function buyOffer(id){
  ensureMarket();
  const o=gameState.market.offers.find(x=>x.id===id); if(!o)return;
  if(o.stock<=0){ SFX.play("error"); showToast("품절된 매물이에요"); return; }
  if(gameState.currency.gold<o.price){ SFX.play("error"); showToast("골드가 부족해요"); return; }
  gameState.currency.gold-=o.price;
  addToInventory({base:o.base,glyph:o.glyph,name:o.name,element:o.element,grade:o.grade,tags:o.tags},1);
  o.stock--; persist(); SFX.play("coin");
  renderMarket(); showToast(`${o.name} 1개 매입 (보유 ${totalStock()})`);
}
marketBody.addEventListener("click",e=>{ if(e.target.closest("#mktRerollBtn")){ rerollMarket(); return; } const b=e.target.closest("[data-offer]"); if(b) buyOffer(b.dataset.offer); });

/* =========================================================
   타로 미니게임 (Phase 4) — 하루 1회 · 액운의 날 보상 강화
   ========================================================= */
const tarotRow=document.getElementById("tarotRow"), tarotAgainWrap=document.getElementById("tarotAgainWrap");
function rollTarotItemGrade(rng, ward){
  const r=rng();
  if(ward){ if(r<0.50)return 1; if(r<0.85)return 2; if(r<0.97)return 3; return 4; }
  if(r<0.60)return 0; if(r<0.90)return 1; if(r<0.99)return 2; return 3;
}
function rollTarotReward(rng, ward){
  const r=rng();
  if(r<0.12){
    const gr=rollTarotItemGrade(rng, ward);
    const p=pickItemOfGrade(rng,gr); const it=makeItem(p[0],p[1]);
    return {type:"item", grade:it.grade, base:it.base, glyph:it.glyph, name:it.name, element:it.element, tags:it.tags};
  }
  let amt; if(r<0.30) amt=400; else if(r<0.62) amt=150; else amt=50;
  if(ward) amt=Math.round(amt*1.5);
  return {type:"gold", amount:amt};
}
function newTarotPicks(salt){
  const rng=mulberry32(hashStr("tarot|"+todayKey()+"|"+(gameState.player.nickname||"")+"|"+salt));
  const ward=isWardDay();
  return [0,1,2].map(()=>rollTarotReward(rng, ward));
}
function ensureTarot(){
  const today=todayKey();
  if(gameState.daily.tarot && gameState.daily.tarot.date===today) return;
  gameState.daily.tarot={ date:today, done:false, chosen:-1, extra:false, picks:newTarotPicks("a") };
  persist();
}
function rewardFace(rw){
  if(rw.type==="gold") return `<span class="tc-ico">🪙</span><span class="tc-amt">${rw.amount.toLocaleString()}냥</span>`;
  const g=GRADES[rw.grade];
  return `<span class="tc-ico">${rw.glyph}</span><span class="tc-name">${rw.name}</span><span class="tc-grade" style="background:${g.color}">${g.name}</span>`;
}
function renderTarot(){
  ensureTarot();
  const t=gameState.daily.tarot, sub=document.getElementById("tarotSub");
  if(!t.done){
    sub.textContent="— 한 장을 골라 운을 점쳐보세요";
    tarotRow.innerHTML=t.picks.map((_,i)=>`<button class="tarot-card" data-tarot="${i}"><div class="tc-inner"><div class="tc-face tc-back">☯</div></div></button>`).join("");
    tarotAgainWrap.innerHTML="";
  }else{
    sub.textContent="— 오늘의 타로 완료";
    tarotRow.innerHTML=t.picks.map((rw,i)=>{
      const chosen=i===t.chosen;
      return `<div class="tarot-card revealed ${chosen?'chosen':'faded'}"><div class="tc-inner flip"><div class="tc-face tc-back">☯</div><div class="tc-face tc-front">${rewardFace(rw)}</div></div></div>`;
    }).join("");
    tarotAgainWrap.innerHTML = t.extra ? "" : `<button class="tarot-again" id="tarotAgainBtn">광고 보고 한 번 더 · 테스트</button>`;
  }
}
function grantTarot(rw){
  SFX.play(rw.type==="gold"?"coin":"rare");
  if(rw.type==="gold"){ gameState.currency.gold+=rw.amount; showToast(`🪙 ${rw.amount.toLocaleString()}냥 획득`); }
  else { addToInventory({base:rw.base,glyph:rw.glyph,name:rw.name,element:rw.element,grade:rw.grade,tags:rw.tags},1); showToast(`${rw.name} 획득 (보유 ${totalStock()})`); }
}
function pickTarot(i){
  const t=gameState.daily.tarot; if(!t||t.done)return;
  t.done=true; t.chosen=i; SFX.play("flip");
  grantTarot(t.picks[i]); persist(); renderTarot();
  const fg=document.getElementById("valGold"); if(fg) fg.textContent=gameState.currency.gold.toLocaleString();
}
function tarotAgain(){
  const t=gameState.daily.tarot; if(!t||t.extra)return;
  t.picks=newTarotPicks("b"+Date.now()); t.done=false; t.chosen=-1; t.extra=true; persist();
  renderTarot(); showToast("광고 시청 완료 · 한 번 더!");
}
tarotRow.addEventListener("click",e=>{ const b=e.target.closest("[data-tarot]"); if(b) pickTarot(+b.dataset.tarot); });
tarotAgainWrap.addEventListener("click",e=>{ if(e.target.closest("#tarotAgainBtn")) tarotAgain(); });

/* =========================================================
   공장 (자동생산) — 도감 기반 제작 · 오프라인 누적 · 받기
   ========================================================= */
const factoryBody=document.getElementById("factoryBody");
let factoryTimer=null, pickRail=-1, pickGrade=0;
function enterFactory(){ renderFactory(); startFactoryTick(); }
function startFactoryTick(){ stopFactoryTick(); factoryTimer=setInterval(tickFactory,1000); }
function stopFactoryTick(){ if(factoryTimer){ clearInterval(factoryTimer); factoryTimer=null; } }
function renderFactory(){
  document.getElementById("facTier").textContent="레일 "+railCount()+"개 · "+GRADES[railMaxGrade()].name+"까지";
  document.getElementById("facCodex").textContent=(gameState.codex||[]).length;
  let html="";
  gameState.factory.rails.forEach((r,i)=>{
    if(r.item){
      const g=GRADES[r.item.grade], stock=railProduced(r), full=stock>=FACTORY_CAP, sec=Math.max(1,Math.round(railInterval(r)/1000));
      html+=`<div class="rail-card" data-rail="${i}">
        <div class="rail-top"><div class="rail-glyph">${r.item.glyph}</div><div class="rail-info"><div class="rail-name">${r.item.name} <span class="rail-grade" style="background:${g.color}">${g.name}</span> <span class="rail-tag">#${r.item.tags.sale}</span></div><div class="rail-sub">Lv.${railLevel(r)} · ${sec}초마다 1개 · <span class="rail-stock">×<b class="rs">${stock}</b></span> / ${FACTORY_CAP}${full?' · 가득 참':''}</div></div></div>
        <div class="rail-bar"><i class="rb" style="width:${Math.round(railProgress(r)*100)}%"></i></div>
        <div class="rail-foot"><button class="rail-btn rcv" data-recv="${i}" ${stock>0?'':'disabled'}>받기${stock>0?` (×${stock})`:''}</button><button class="rail-btn ghost" data-edit="${i}">품목 변경</button></div>
      </div>`;
    }else{
      html+=`<div class="rail-card" data-rail="${i}">
        <div class="rail-top"><div class="rail-glyph empty">＋</div><div class="rail-info"><div class="rail-name">빈 레일</div><div class="rail-sub">제작할 품목이 없습니다</div></div></div>
        <div class="rail-foot"><button class="rail-btn" data-edit="${i}">도감에서 품목 선택</button></div>
      </div>`;
    }
  });
  html+=`<div class="fac-stat">레일 추가 · 제작 등급 해금은 <b>성장</b> 탭에서 · 생산물은 받기 전까지 레일당 최대 <b>${FACTORY_CAP}개</b>까지 쌓입니다(앱을 꺼둬도 누적).</div>`;
  factoryBody.innerHTML=html;
}
function tickFactory(){
  gameState.factory.rails.forEach((r,i)=>{
    if(!r.item) return;
    const card=factoryBody.querySelector(`[data-rail="${i}"]`); if(!card) return;
    const stock=railProduced(r);
    const rs=card.querySelector(".rs"); if(rs) rs.textContent=stock;
    const rb=card.querySelector(".rb"); if(rb) rb.style.width=Math.round(railProgress(r)*100)+"%";
    const btn=card.querySelector(".rcv"); if(btn){ btn.disabled=stock<=0; btn.textContent="받기"+(stock>0?` (×${stock})`:""); }
  });
}
function receiveRail(i){
  const r=gameState.factory.rails[i]; if(!r||!r.item) return;
  const stock=railProduced(r); if(stock<=0) return;
  addToInventory(r.item, stock); r.since=Date.now(); persist();
  SFX.play("receive");
  renderFactory(); showToast(`${r.item.name} ×${stock} 수령 (보유 ${totalStock()})`);
}
/* 자동 수령원(아르바이트) — 켜져 있는 동안 주기적으로 레일을 비워 생산이 멈추지 않게 */
function autoCollectTick(){
  const lv=staffLv("collector"); if(lv<=0) return;
  if(!gameState.factory || !gameState.factory.rails) return;
  const thr=Math.max(1, Math.ceil(FACTORY_CAP*STAFF_COLLECT_RATIO[lv]));
  let any=false;
  gameState.factory.rails.forEach(r=>{
    if(!r.item) return; const stock=railProduced(r);
    if(stock>=thr){ addToInventory(r.item, stock); r.since=Date.now(); any=true; }
  });
  if(any){ persist(); if(factoryTimer) renderFactory(); }   // 공장 화면을 보고 있으면 갱신
}
setInterval(autoCollectTick, STAFF_COLLECT_SEC*1000);
factoryBody.addEventListener("click",e=>{
  const rec=e.target.closest("[data-recv]"), ed=e.target.closest("[data-edit]");
  if(rec) receiveRail(+rec.dataset.recv);
  else if(ed) openRailPicker(+ed.dataset.edit);
});
/* 품목 선택 모달 */
function openRailPicker(i){
  if(!(gameState.codex||[]).length){ showToast("먼저 아이템을 모아 도감을 채우세요"); return; }
  pickRail=i; renderPicker();
  document.getElementById("railPicker").hidden=false;
}
function renderPicker(){
  document.getElementById("pkGrades").innerHTML="";   // 등급은 외형×색 조합으로 결정 — 칩 없음
  const list=(gameState.codex||[]).map(key=>{ const p=key.split("|").map(Number); return {key,bi:p[0],el:p[1],grade:gradeOf(p[0],p[1])}; }).sort((a,b)=>a.grade-b.grade || a.bi-b.bi || a.el-b.el);
  document.getElementById("pkGrid").innerHTML=list.map(o=>{
    const it=makeItem(o.bi,o.el), g=GRADES[o.grade], locked=o.grade>railMaxGrade();
    return `<button class="pk-item ${locked?'locked':''}" data-key="${o.key}" ${locked?'disabled':''}><span class="pk-glyph">${it.glyph}</span><span class="pk-name">${it.name}</span><span class="pk-gb" style="background:${g.color}">${locked?'🔒 ':''}${g.name}</span><span class="pk-tag">#${it.tags.sale}</span></button>`;
  }).join("");
  document.getElementById("pkSub").textContent=`도감 ${list.length}종 · 현재 ${GRADES[railMaxGrade()].name}까지 제작 가능 (상위는 성장 탭에서 해금)`;
}
function setRailItem(key){
  const r=gameState.factory.rails[pickRail]; if(!r) return;
  const p=key.split("|").map(Number);
  if(gradeOf(p[0],p[1])>railMaxGrade()){ SFX.play("error"); showToast("아직 잠긴 등급이에요 (성장 탭에서 해금)"); return; }
  r.item=makeItem(p[0],p[1]); r.since=Date.now(); persist();
  SFX.play("place");
  document.getElementById("railPicker").hidden=true;
  renderFactory(); showToast(`${r.item.name} 제작 시작`);
}
document.getElementById("pkGrid").addEventListener("click",e=>{ const b=e.target.closest("[data-key]"); if(b) setRailItem(b.dataset.key); });
document.getElementById("pkClose").addEventListener("click",()=>{ document.getElementById("railPicker").hidden=true; });

/* 습득 도감 — 전체 50종, 미습득은 검은 실루엣 */
function renderCodex(){
  const codex=gameState.codex||[], all=[];
  for(let b=0;b<BASE.length;b++) for(let e=0;e<ELEMENTS.length;e++) all.push({b,e,key:b+"|"+e,grade:gradeOf(b,e)});
  all.sort((x,y)=>x.grade-y.grade || x.b-y.b || x.e-y.e);
  document.getElementById("cdxSub").textContent=`${codex.length} / ${all.length}`;
  document.getElementById("cdxGrid").innerHTML=all.map(o=>{
    if(codex.includes(o.key)){ const it=makeItem(o.b,o.e), g=GRADES[o.grade];
      return `<div class="cdx-cell got"><span class="cdx-glyph">${it.glyph}</span><span class="cdx-gb" style="background:${g.color}">${g.name}</span><span class="cdx-name">${it.name}</span><span class="cdx-tag">#${it.tags.sale}</span></div>`;
    }
    return `<div class="cdx-cell"><span class="cdx-glyph silhouette">${BASE[o.b].glyph}</span><span class="cdx-name muted">？？？</span></div>`;
  }).join("");
}
document.getElementById("codexBtn").addEventListener("click",()=>{ SFX.play("modal"); renderCodex(); document.getElementById("codexModal").hidden=false; });
document.getElementById("cdxClose").addEventListener("click",()=>{ document.getElementById("codexModal").hidden=true; });

/* =========================================================
   초기화 / 마이그레이션 / 부팅
   ========================================================= */
function showToast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(showToast._t);showToast._t=setTimeout(()=>t.classList.remove("show"),1900);}
const resetBtn=document.getElementById("resetBtn");
let resetArmed=false,resetTimer=null;
function disarmReset(){resetArmed=false;resetBtn.textContent="초기화";resetBtn.classList.remove("armed");}
function doReset(){
  store.clear();gameState=defaultState();
  document.getElementById("nickname").value="";
  document.getElementById("birthYear").value="";document.getElementById("birthMonth").value="";refreshDays();
  document.getElementById("birthHour").value="";document.getElementById("obErr").textContent="";
  document.getElementById("itemCard").classList.remove("flipped");
  showScreen("onboarding");
}
resetBtn.addEventListener("click",()=>{
  if(!resetArmed){ resetArmed=true;resetBtn.textContent="한 번 더 탭";resetBtn.classList.add("armed");clearTimeout(resetTimer);resetTimer=setTimeout(disarmReset,2500);return; }
  clearTimeout(resetTimer);disarmReset();doReset();
});

/* 과거 기본(테스트) 재고 제거 (구버전 정리) */
function purgeStarterStock(){
  if(!gameState.meta.shopStocked || gameState.meta.starterPurged) return;
  const sigs=BASE.map((b,i)=>`${b.name}|${i%5}|0`);
  sigs.forEach(sig=>{ const idx=gameState.inventory.findIndex(it=>it.qty===undefined && `${it.base}|${it.element}|${it.grade}`===sig); if(idx!==-1) gameState.inventory.splice(idx,1); });
  gameState.meta.starterPurged=true; persist();
}
/* 구버전 인벤토리(개별 객체)를 수량 스택으로 변환 */
function migrateInventory(){
  if(!gameState.inventory.length) return;
  if(gameState.inventory[0].qty!==undefined) return; // 이미 스택
  const stacks=[];
  gameState.inventory.forEach(it=>{
    const k=`${it.base}|${it.element}|${it.grade}`, st=stacks.find(s=>`${s.base}|${s.element}|${s.grade}`===k);
    if(st) st.qty++;
    else stacks.push({ id:uid(), base:it.base, glyph:it.glyph, name:it.name, element:it.element, grade:it.grade, tags:{...it.tags}, qty:1 });
  });
  gameState.inventory=stacks; gameState.display.slots=[null,null,null]; persist();
}
function normalizeState(){
  const s=gameState.shop;
  if(!s.facilities) s.facilities=[];
  if(typeof s.stage!=="number") s.stage=1;
  if(typeof s.salesGold!=="number") s.salesGold=0;
  if(typeof s.salesUnits!=="number") s.salesUnits=0;
  if(typeof s.activeMs!=="number") s.activeMs=0;
  if(!gameState.market) gameState.market={date:null,offers:[]};
  if(!gameState.staff) gameState.staff={display:0,collector:0};
  if(typeof gameState.staff.display!=="number") gameState.staff.display=0;
  if(typeof gameState.staff.collector!=="number") gameState.staff.collector=0;
  if(!gameState.codex) gameState.codex=[];
  if(!gameState.factory) gameState.factory={railTier:1, rails:[{item:null, since:Date.now()}]};
  if(typeof gameState.factory.railTier!=="number") gameState.factory.railTier=1;
  if(!Array.isArray(gameState.factory.rails) || !gameState.factory.rails.length) gameState.factory.rails=[{item:null, since:Date.now()}];
  gameState.factory.rails.forEach(r=>{ if(typeof r.since!=="number") r.since=Date.now(); if(typeof r.level!=="number") r.level=1; });
  gameState.inventory.forEach(it=>codexAdd(it));   // 보유 아이템으로 도감 시드
}
/* 외형 고정 등급으로 1회 정리(구버전 무작위 등급 데이터) */
function regradeOnce(){
  if(gameState.meta.regraded2) return;
  const map={};
  gameState.inventory.forEach(it=>{
    const bi=BASE.findIndex(b=>b.name===it.base); if(bi<0) return;
    const b=BASE[bi], el=ELEMENTS[it.element], key=it.base+"|"+it.element;
    if(map[key]) map[key].qty+=it.qty;
    else map[key]={ id:it.id, base:b.name, glyph:b.glyph, name:(el?el.prefix+" ":"")+b.name, element:it.element, grade:gradeOf(bi,it.element), tags:{sale:b.sale, attr:el?el.key:""}, qty:it.qty };
  });
  gameState.inventory=Object.values(map);
  gameState.display.slots=[null,null,null];
  gameState.factory.rails.forEach(r=>{ if(r.item){ const bi=BASE.findIndex(b=>b.name===r.item.base); if(bi>=0){ const b=BASE[bi], el=ELEMENTS[r.item.element]; r.item.grade=gradeOf(bi,r.item.element); r.item.glyph=b.glyph; r.item.tags={sale:b.sale, attr:el?el.key:""}; } } });
  if(gameState.market) gameState.market.date=null;   // 시장 재생성
  gameState.daily.tarot=null;                         // 옛 보상 정리
  gameState.meta.regraded=true; gameState.meta.regraded2=true; persist();
}

fillDateSelects();
purgeStarterStock();
migrateInventory();
normalizeState();
regradeOnce();
checkOfflineIncome(false);
showScreen(gameState.meta.onboarded?"fortune":"onboarding");
</script>
</body>
</html>
